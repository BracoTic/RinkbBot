# =============================================================
#  RinkBot Backend — Variables de entorno
#  Copia este archivo como .env y reemplaza los valores.
#  NUNCA subas .env con secretos reales al repositorio.
# =============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
OPENAI_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- PostgreSQL / Supabase ---
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_NAME=postgres
# SSL: "true" verifica certificados (recomendado en producción).
# En desarrollo con Supabase pooler puede dejarse en "false".
# Si no se define, se usa "true" cuando NODE_ENV=production, "false" en otro caso.
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Google Drive ---
SYSTEM_FOLDER_ID=your_google_drive_folder_id

# --- RAG / Drive Indexing ---
DRIVE_SYNC_BATCH_FILES=10
DRIVE_MAX_TEXT_CHARS=60000
DRIVE_MAX_FILE_BYTES=120000000
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=250

# --- RAG Retrieval ---
RAG_TOP_K=10
RAG_MIN_SIMILARITY=0.35
# RAG_DISABLE_FOR_SMALL_QUERIES deprecated — replaced by classifyIntent
# RAG_MIN_QUERY_CHARS deprecated — replaced by classifyIntent
RAG_HIGH_CONFIDENCE=0.45   # above this, web search is suppressed regardless of message content
RAG_BLOCKLIST_REGEX=contrasen|password|clave|secret|api[_-]?key|token

# --- JWT Auth ---
# IMPORTANTE: Cambiar por un string aleatorio de 64+ caracteres en producción.
JWT_SECRET=CHANGE_ME_use_random_64_char_string
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=3000
# Orígenes permitidos. Para producción, usa el dominio real del frontend.
# Soporta múltiples orígenes separados por coma: https://app.example.com,https://www.example.com
CORS_ORIGIN=*
MAX_MESSAGE_CHARS=4000
MAX_IMAGE_BYTES=10485760   # 10 MB default for image uploads

# --- Chat Display ---
CHAT_APPEND_SOURCES=true
CHAT_MAX_SOURCES_TO_SHOW=3

# --- Web Search (SerpAPI) ---
WEB_SEARCH_ENABLED=false
SERPAPI_KEY=your_serpapi_key_here

# --- OpenAI generation parameters ---
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1500

# --- Environment ---
# La plataforma de deploy (Render, Railway) setea esto automáticamente.
NODE_ENV=development
